<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.abir_2307055.cloudsort.cloudsort.DashboardController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="folderPathLabel" text="No folder selected"/>
    <Button text="Select Folder" onAction="#onSelectFolderClicked"/>
    <Button text="Scan" onAction="#onScanClicked"/>

    <TableView fx:id="fileTableView" prefHeight="250.0" prefWidth="500.0">
        <columns>
            <TableColumn fx:id="nameColumn" text="File Name" prefWidth="300.0"/>
            <TableColumn fx:id="extensionColumn" text="Extension" prefWidth="150.0"/>
        </columns>
    </TableView>
</VBox>